# MailGuard configuration — copy to .env and fill in every CHANGE_ME value.
#   cp .env.example .env
# Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=mailguard
DB_USER=mailguard
# Generate each with: openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# ── API ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48 | tr -dc 'A-Za-z0-9'
JWT_SECRET=CHANGE_ME
API_PORT=3001
NODE_ENV=production

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_HOSTNAME=mail.example.com
SMTP_PORT=25
SMTP_SUBMISSION_PORT=587
# Internal mail server that accepted mail is relayed on to
SMTP_RELAY_HOST=192.0.2.10
SMTP_RELAY_PORT=25
# Domain part of MAIL_HOSTNAME (e.g. if hostname is mail.example.com, domain is example.com)
MAIL_DOMAIN=example.com
# Comma-separated list of domains to accept inbound mail for
RELAY_DOMAINS=example.com, example.org

# ── Admin ─────────────────────────────────────────────────────────────────────
# Initial admin account, created on first database init only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# ── Features ──────────────────────────────────────────────────────────────────
ENABLE_CLAMAV=true
ENABLE_SPAMASSASSIN=true
ENABLE_SPF=true
ENABLE_DKIM=true
ENABLE_DMARC=true

# Internal API token — shared secret between Postfix/Amavis and the backend
# Generate with: openssl rand -hex 32
MAILGUARD_INTERNAL_TOKEN=CHANGE_ME
MAILGUARD_API_URL=http://backend:3001

# MaxMind GeoLite2 — free account at https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=CHANGE_ME
MAXMIND_ACCOUNT_ID=CHANGE_ME

# Alert email recipient
ALERT_EMAIL=admin@example.com

# Report email recipient
REPORT_EMAIL=admin@example.com

# SMTP settings for sending alerts/reports out via postfix container
SMTP_FROM=mailguard@example.com
SMTP_HOST=postfix
